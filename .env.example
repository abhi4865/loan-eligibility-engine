# .env.example
# Copy this file to ".env" and change the values marked CHANGE_ME.
# NEVER commit the real .env file (it is listed in .gitignore).

# ---------- Postgres ----------
# POSTGRES_HOST=localhost is for programs on YOUR computer (scripts, local Lambdas).
# Inside Docker (for example n8n) the host name is "postgres" instead.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=loan_db
POSTGRES_USER=loan_user
POSTGRES_PASSWORD=CHANGE_ME_db_password

# ---------- MinIO (local S3) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
S3_BUCKET=loan-uploads
# Used by boto3 only when running locally. Leave empty on real AWS.
S3_ENDPOINT_URL=http://localhost:9000
AWS_REGION=ap-south-1
# Local MinIO browser CORS. Restrict to http://localhost:8000 for a tighter demo setup.
MINIO_API_CORS_ALLOW_ORIGIN=*
# For MinIO these two are the same as the MinIO user and password above.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=CHANGE_ME_minio_password

# ---------- n8n ----------
# Any long random text. Used to encrypt credentials saved inside n8n.
# Make one with:  openssl rand -hex 24
N8N_ENCRYPTION_KEY=CHANGE_ME_long_random_text
# Shared secret the parser Lambda sends to n8n in the header X-Webhook-Secret.
N8N_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
# Where the parser Lambda sends its "CSV is ready" message.
# host.docker.internal lets a Lambda running in Docker reach n8n on your computer.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/users-processed

# ---------- Email (used in phase 5) ----------
SES_SENDER_EMAIL=your_verified_sender@gmail.com
# Your own Gmail aliases. Replace "yourname" with your real Gmail username.
TEST_EMAIL_1=yourname+one@gmail.com
TEST_EMAIL_2=yourname+two@gmail.com
# Safety cap: the most emails one pipeline run may send.
MAX_DEMO_EMAILS=5

# ---------- LLM (used in phase 4) ----------
LLM_API_KEY=
LLM_MODEL=

# ---------- Optional AWS deployment (Phase 7) ----------
# AWS credentials should come from an AWS CLI profile/role, not this file.
# Set AWS_ACCOUNT_ID to your AWS account number to scope SES IAM permissions.
AWS_ACCOUNT_ID=
# Set AWS_S3_BUCKET to a globally unique name, or leave empty to use the
# placeholder default for packaging. Set a unique name before deployment.
AWS_S3_BUCKET=
# Use an HTTPS URL for the deployed browser page; '*' is only for demos.
AWS_UI_ORIGIN=*
# For a private RDS instance, set USE_VPC=on and provide its Lambda subnets
# and security group. RDS itself is documented as external; this stack does
# not create a database.
USE_VPC=off
VPC_SECURITY_GROUP_ID=
VPC_SUBNET_ID_1=
VPC_SUBNET_ID_2=
# These are deployment-specific to avoid passing local localhost/MinIO values.
AWS_POSTGRES_HOST=
AWS_POSTGRES_PORT=5432
AWS_POSTGRES_DB=
AWS_POSTGRES_USER=
AWS_POSTGRES_PASSWORD=
AWS_N8N_WEBHOOK_URL=
AWS_N8N_WEBHOOK_SECRET=
