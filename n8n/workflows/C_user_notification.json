    {
      "parameters": {
        "jsCode": "const body = $('Matching complete webhook').first().json.body || {};\nconst batchId = String(body.batch_id || '');\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(batchId)) throw new Error('batch_id is missing or is not a UUID');\nconst max = Math.max(0, Math.min(100, Number.parseInt($env.MAX_DEMO_EMAILS || '5', 10) || 5));\nconst aliases = [String($env.TEST_EMAIL_1 || '').trim(), String($env.TEST_EMAIL_2 || '').trim()];\nconst sender = String($env.SES_SENDER_EMAIL || '').trim();\nif (!sender || !aliases.every(x => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(x)) || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(sender)) throw new Error('Configure SES_SENDER_EMAIL and both TEST_EMAIL_* values as valid addresses before sending');\nreturn [{json:{batch_id:batchId,max_emails:max,test_emails:aliases,sender_email:sender}}];"
      },
      "name": "Validate batch and demo settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        160
      ],
      "id": "c001a26b-b893-4d4d-b6a9-8385d1000004"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH picked AS (\n  SELECT m.user_id, u.name, p.product_name, p.provider, p.interest_rate, m.product_id,\n         row_number() OVER (PARTITION BY m.user_id ORDER BY p.provider, p.product_name, m.product_id) AS product_rank\n  FROM matches m\n  JOIN users u ON u.user_id = m.user_id\n  JOIN loan_products p ON p.product_id = m.product_id\n  WHERE m.batch_id = $1::uuid AND m.notified = false\n), selected AS (\n  SELECT * FROM picked WHERE product_rank <= 5\n), per_user AS (\n  SELECT user_id, max(name) AS name, jsonb_agg(jsonb_build_object('product_name',product_name,'provider',provider,'interest_rate',interest_rate) ORDER BY provider,product_name) AS products\n  FROM selected GROUP BY user_id ORDER BY user_id LIMIT $2::int\n)\nSELECT user_id, name, products, row_number() OVER (ORDER BY user_id) AS recipient_number\nFROM per_user ORDER BY user_id",
        "options": {
          "queryReplacement": "={{ $('Validate batch and demo settings').first().json.batch_id }},{{ $('Validate batch and demo settings').first().json.max_emails }}"
        }
      },
      "name": "Select capped users and products",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        680,
        160
      ],
      "alwaysOutputData": true,
      "id": "c001a26b-b893-4d4d-b6a9-8385d1000005",
      "credentials": {
        "postgres": {
          "id": "k5WRDqC6MeG2K79e",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Validate batch and demo settings').first().json;\nconst esc = v => String(v ?? '').replace(/[&<>\\\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\"'\":'&#39;'}[c]));\nconst rows = $input.all().filter(i => i.json.user_id);\nif (!rows.length) return [{json:{dummy:true,batch_id:cfg.batch_id}}];\nreturn rows.map(item => {\n const r=item.json, products=Array.isArray(r.products)?r.products:JSON.parse(r.products||'[]');\n const to=cfg.test_emails[(Number(r.recipient_number)-1)%cfg.test_emails.length];\n const greeting=r.name?`Hi ${esc(r.name)}`:'Hi there';\n const list=products.map(p=>`<li><strong>${esc(p.product_name)}</strong> — ${esc(p.provider)}${p.interest_rate===null?'':` — ${esc(p.interest_rate)}% p.a.`}</li>`).join('');\n const html=`<p>${greeting},</p><p>Here are loan products that may match your profile:</p><ul>${list}</ul><p>Rates and eligibility are subject to lender confirmation.</p>`;\n return {json:{user_id:r.user_id,batch_id:cfg.batch_id,to,from:cfg.sender_email,subject:'Loan products that may fit your profile',html}};\n});"
      },
